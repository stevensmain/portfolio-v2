    "@types/react-dom": "18.2.25",
    "@types/three": "^0.177.0",
    "astro": "5.9.2",
    "clsx": "^2.1.1",
    "geist": "^1.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "scrollreveal": "4.0.9",
    "tailwindcss": "^3.4.1",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
