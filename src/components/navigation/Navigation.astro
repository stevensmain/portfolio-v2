---
import GithubRounded from '../icons/GithubRounded.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import Mail from '../icons/Mail.astro';
import Text from '../ui/Text.astro';

const rrss = [
  {
    name: 'GitHub',
    href: 'https://github.com/stevensmain',
    icon: GithubRounded,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/stevens-carrasquel',
    icon: LinkedIn,
  },
  {
    name: 'Mail',
    href: 'mailto:stevensgoldzyzz@gmail.com',
    icon: Mail,
  },
];

const sections = [
  {
    label: 'Acerca de mi',
    id: 'about',
  },
  {
    label: 'Experiencias',
    id: 'experiences',
  },
  {
    label: 'Proyectos',
    id: 'projects',
  },
];
---

<header
  class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:py-24"
  id="hero"
>
  <div>
    <h2 class="text-4xl font-bold tracking-tight text-slate-200 sm:text-5xl">Stivens Carrasquel</h2>
    <h3 class="mt-3 text-lg font-medium tracking-tight text-slate-200 sm:text-xl">
      Desarrollador Full-Stack
    </h3>
    <Text class="mt-4 max-w-md leading-normal text-slate-200">
      Desarrollador Full-Stack con 5+ años creando aplicaciones web escalables. Especializado en
      JavaScript, TypeScript, React, Node.js y Next.js, con experiencia en desarrollo de interfaces
      modernas y APIs RESTful/GraphQL. Enfocado en la calidad del código y mejores prácticas de
      desarrollo.
    </Text>

    <nav class="nav hidden lg:block">
      <ul class="mt-8 w-max">
        {
          sections.map(({ id, label }) => (
            <li>
              <a class="group flex items-center py-3" href={`#${id}`}>
                <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-14 group-hover:bg-slate-200 group-focus-visible:w-14 group-focus-visible:bg-slate-200 motion-reduce:transition-none" />

                <span class="nav-text text-xs font-bold tracking-widest text-slate-500 uppercase group-hover:text-slate-200 group-focus-visible:text-slate-200">
                  {label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <ul class="mt-8 ml-1 flex items-center">
    {
      rrss.map(({ name, href, icon: Icon }) => (
        <li class="mr-5 text-xs">
          <a class="block hover:text-slate-200" href={href} target="_blank" rel="noreferrer">
            <span class="sr-only">{name}</span>
            <Icon />
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const ACTIVE_CLASSES = {
    indicator: {
      active: ['w-14', 'bg-slate-200'],
      inactive: ['w-8', 'bg-slate-600'],
    },
    text: {
      active: ['text-slate-200'],
      inactive: ['text-slate-500'],
    },
  };

  function toggleClasses(element: Element, classes: string[], add: boolean) {
    classes.forEach((className) => {
      element.classList[add ? 'add' : 'remove'](className);
    });
  }

  function handleIntersect(entries: IntersectionObserverEntry[]) {
    const entry = entries[0];
    const id = entry.target.getAttribute('id');
    if (!id) return;

    const navElements = document.querySelectorAll(`header nav ul a[href*="${id}"] span`);
    if (navElements.length !== 2) return;

    const [indicator, text] = navElements;
    const isIntersecting = entry.isIntersecting;

    toggleClasses(indicator, ACTIVE_CLASSES.indicator.active, isIntersecting);
    toggleClasses(indicator, ACTIVE_CLASSES.indicator.inactive, !isIntersecting);
    toggleClasses(text, ACTIVE_CLASSES.text.active, isIntersecting);
    toggleClasses(text, ACTIVE_CLASSES.text.inactive, !isIntersecting);
  }

  function createObserver(target: Element) {
    const observer = new IntersectionObserver(handleIntersect, {
      rootMargin: '-230px',
      threshold: 0,
    });
    observer.observe(target);
    return observer;
  }

  window.addEventListener('load', () => {
    const sections = document.querySelectorAll('section[id]');
    const observers: IntersectionObserver[] = [];

    sections.forEach((section) => {
      const observer = createObserver(section);
      observers.push(observer);
    });
  });
</script>
