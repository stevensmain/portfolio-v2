---
import AstroBuild from '../icons/AstroBuild.astro';
import Netilfy from '../icons/Netlify.astro';
import Tailwind from '../icons/Tailwind.astro';
import Container from '../ui/Container.astro';
---

<Container>
  <div class="mx-auto flex max-w-xl flex-col gap-5 text-center">
    <div class="flex items-center justify-center gap-3">
      <AstroBuild className="h-12 w-12" />
      <Tailwind className="h-12 w-12" />
      <Netilfy className="h-12 w-12" />
    </div>

    <p>
      Built with
      <a
        href="https://astro.build/"
        class="font-medium text-slate-400 hover:text-teal-300 focus-visible:text-teal-300"
        target="_blank"
        rel="noreferrer noopener"
      >
        Astro
      </a>
      and
      <a
        href="https://tailwindcss.com/"
        class="font-medium text-slate-400 hover:text-teal-300 focus-visible:text-teal-300"
        target="_blank"
        rel="noreferrer noopener"
      >
        Tailwind CSS
      </a>, deployed with
      <a
        href="https://www.netlify.com/"
        class="font-medium text-slate-400 hover:text-teal-300 focus-visible:text-teal-300"
        target="_blank"
        rel="noreferrer noopener"
      >
        Netilfy
      </a>.
    </p>
  </div>
</Container>
