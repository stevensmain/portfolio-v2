---
import About from '../components/about/About.astro';
import Experiences from '../components/experiences/Experiences.astro';
import Footer from '../components/footer/Footer.astro';
import Projects from '../components/projects/Projects.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="lg:w-1/2">
    <About />
    <Experiences />
    <Projects />
    <Footer />
  </main>
</Layout>

<style>
  main {
    margin: auto;
    scroll-bar: none;
  }
  .sideline::after {
    content: '';
    background-color: slategray;
    display: block;
    position: relative;
    height: 100px;
    margin: 10px auto 0;
    width: 1px;
    transition: 200ms;
  }
  .sideline:hover::after {
    transform: scaleY(1.1);
  }
</style>

<script>
  import sr, { srConfig } from '../lib/scrollReveal';
  const revealContainers = document.querySelectorAll('.reveal');
  revealContainers.forEach((el) => sr.reveal(el, srConfig()));
</script>
